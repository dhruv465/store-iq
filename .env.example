# Store IQ — associate-facing WhatsApp assistant. Test number and test data only.
PORT=3000
HOST=127.0.0.1
LOCAL_DB_PATH=data/runtime/pg
PACK_PATH=data/pack.json

# Your one free ngrok static domain, e.g. store-iq.ngrok-free.app. Set it and the Meta callback
# URL never changes again. Claim it at dashboard.ngrok.com -> Domains. Then: npm run tunnel
NGROK_DOMAIN=

# Optional. Leave EMPTY so any associate who messages the number gets a reply.
# Set it only to pin replies to specific handsets, e.g. ALLOWED_PHONES=9198XXXXXXXX during a rehearsal.
# Replies are limited to numbers that messaged first by the 24 hour window, with or without this list.
ALLOWED_PHONES=

# WhatsApp Cloud API (test number)
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# fal.ai's OpenRouter router answers the turn when this is set, and Gemini is not needed for it.
# Charged on tokens used: about 3,200 in and 50 out per turn. Measured on real turns, 30 Oct:
#   google/gemini-2.5-flash      $0.0007-$0.0015 a turn — the default, and the only cheap one
#                                whose Hindi and Marathi come back clean
#   anthropic/claude-haiku-4.5   works, roughly three times that
#   mistralai/mistral-small-24b-instruct-2501  ~$0.00015, and it invented a brand warranty and a
#                                price match with Croma. Do not use it on the floor.
# Several cheaper slugs are refused outright by the router: qwen/qwen3.7-flash on the account's
# zero-data-retention policy, glm-5.3-flash and gpt-5-nano because reasoning cannot be disabled.
# See the table in server/src/fal.ts.
FAL_KEY=
FAL_MODEL=

# Gemini. Optional, and only for the shelf-tag photo: fal answers the turn and transcribes the
# voice note. Leave it empty and a photo answers "I could not read a model off that photo. Type the
# model number, or the brand and the size." Without FAL_KEY, Gemini answers everything instead, on
# a free tier of 20 requests a day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Manager dashboard at /manager (off when ADMIN_PASSWORD is unset)
ADMIN_USER=manager
ADMIN_PASSWORD=
ADMIN_NAME=Store manager

# Paste the three values, restart the server, done. Nothing else changes: the startup line
# will read "pack live-YYYY-MM-DD (live catalogue · N products)" instead of "stub-1", and the
# products, prices and promotions come from the store instead of data/pack.json.
#
# STOREFRONT application credentials, not platform or partner ones. Read-only by construction:
# server/src/catalog.ts can issue a GET to five /service/application/ paths and holds no write
# code at all. If the keys are wrong the server says so and serves data/pack.json, so the number
# stays alive either way.
#
# Check them before the number serves them:  npm run pack:check -- live
CATALOG_HOST=
CATALOG_APPLICATION_ID=
CATALOG_APPLICATION_TOKEN=
# What getProducts is asked for. Default: television
CATALOG_QUERY=
